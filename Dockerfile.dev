FROM python:3.14-slim

LABEL org.opencontainers.image.source="https://github.com/uprightbass360/automatic-ripping-machine-transcoder"
LABEL org.opencontainers.image.license="MIT"
LABEL org.opencontainers.image.description="GPU-accelerated transcoding service for ARM (dev)"

RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Match production UID/GID (Dockerfile uses 1001:1000) so dev and prod
# containers can share the same DB volume without permission errors.
ARG TRANSCODER_UID=1001
ARG TRANSCODER_GID=1000
RUN groupadd -g ${TRANSCODER_GID} transcoder \
    && useradd -m -s /bin/bash -u ${TRANSCODER_UID} -g transcoder transcoder

WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY src/ /app/
COPY presets/ /config/presets/

RUN mkdir -p /data/raw /data/completed /data/work /data/db /data/logs \
    && chown -R transcoder:transcoder /data /app /config

USER transcoder

EXPOSE 5000

CMD ["python", "-m", "uvicorn", "main:app", "--host", "0.0.0.0", "--port", "5000", "--reload", "--reload-dir", "/app"]
